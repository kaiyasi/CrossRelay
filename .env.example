DISCORD_TOKEN=your-discord-bot-token
TELEGRAM_TOKEN=your-telegram-bot-token

# Optional bridge tuning. Message mappings are retained for 7 days by default.
# BRIDGE_STATE_MAX_AGE_HOURS=168
# BRIDGE_STATE_MAX_ENTRIES=10000
# BRIDGE_MEDIA_UPLOAD_MAX_MB=8

# Bridge 1 — group "team-a": TG chat ↔ DC channel
BRIDGE_1_GROUP=team-a
BRIDGE_1_TELEGRAM_CHAT_ID=-1001234567890
BRIDGE_1_DISCORD_CHANNEL_ID=123456789012345678

# Bridge 2 — same group "team-a": adds a second DC channel to the same group
# BRIDGE_2_GROUP=team-a
# BRIDGE_2_TELEGRAM_CHAT_ID=-1001234567890
# BRIDGE_2_DISCORD_CHANNEL_ID=222222222222222222

# Bridge 3 — different group "team-b": fully independent bridge
# BRIDGE_3_GROUP=team-b
# BRIDGE_3_TELEGRAM_CHAT_ID=-1009876543210
# BRIDGE_3_DISCORD_CHANNEL_ID=987654321098765432

# Omit GROUP to put a bridge in the default group (all no-group bridges share one pool)
# BRIDGE_4_TELEGRAM_CHAT_ID=-1005555555555
# BRIDGE_4_DISCORD_CHANNEL_ID=555555555555555555

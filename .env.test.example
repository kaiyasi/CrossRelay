# Test environment variables for local/staging bridge tests
NODE_ENV=test

# Option A: put test values directly in .env.test
DISCORD_TOKEN=your_test_discord_bot_token
TELEGRAM_TOKEN=your_test_telegram_bot_token
BRIDGE_1_GROUP=test
BRIDGE_1_TELEGRAM_CHAT_ID=your_test_telegram_chat_id
BRIDGE_1_DISCORD_CHANNEL_ID=your_test_discord_channel_id

# Option B: keep everything in .env with TEST_ prefix (also supported when NODE_ENV=test)
# TEST_DISCORD_TOKEN=your_test_discord_bot_token
# TEST_TELEGRAM_TOKEN=your_test_telegram_bot_token
# TEST_BRIDGE_1_GROUP=test
# TEST_BRIDGE_1_TELEGRAM_CHAT_ID=your_test_telegram_chat_id
# TEST_BRIDGE_1_DISCORD_CHANNEL_ID=your_test_discord_channel_id
